# Future model integration only. The current Go CLI does not load .env or read these keys.
# Copy to .env and fill local model directories or cloud API settings after an adapter exists.
# Keep enabled=false until the corresponding model path is implemented and verified.

# Local semantic retrieval: model directory should include weights and tokenizer.
RAGBOT_EMBEDDING_ENABLED=false
RAGBOT_EMBEDDING_MODEL_DIR=

# Local query-passage reranking.
RAGBOT_RERANKER_ENABLED=false
RAGBOT_RERANKER_MODEL_DIR=

# Optional cloud answer wording gateway; leave disabled for deterministic answers.
# The proposed adapter uses an OpenAI-compatible API. Confirm the provider contract before enabling it.
RAGBOT_GENERATOR_ENABLED=false
RAGBOT_GENERATOR_PROVIDER=openai_compatible
RAGBOT_GENERATOR_BASE_URL=
RAGBOT_GENERATOR_MODEL=
RAGBOT_GENERATOR_API_KEY=
RAGBOT_GENERATOR_TIMEOUT_SECONDS=30
